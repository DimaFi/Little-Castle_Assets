# Large authored binaries remain in this local workspace. GitHub stores their
# Asset Book entries, scripts, specs and hash manifest, not binary backups.
*.blend
*.fbx
*.png
*.jpg
*.jpeg
*.exr
*.tga
*.psd
*.wav
*.uasset
*.umap
*.uproject

# Blender recovery and local UI state
*.blend@
*.blend~
*.blend[0-9]
*.blend1
__pycache__/
*.py[cod]
*.log

# OS/editor noise
.DS_Store
Thumbs.db
.vs/
.idea/

# Never version engine-generated caches or logs.
DerivedDataCache/
Intermediate/
Saved/
Library/
Temp/
Logs/
UserSettings/
