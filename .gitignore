# Large authored binaries remain in this local workspace. GitHub stores their
# Asset Book entries, scripts, specs and hash manifest, not binary backups.
*.blend
*.fbx
*.png
*.jpg
*.jpeg
*.exr
*.tga
*.psd
*.wav
*.uasset
*.umap
*.uproject

# User requested publishing the current versioned sources/releases on 2026-10-08.
# Their binary payloads are protected by .gitattributes / Git LFS.
!/Source/**/*.blend
!/Source/**/*.fbx
!/Source/**/*.png
!/Source/**/*.jpg
!/Source/**/*.jpeg
!/Source/**/*.exr
!/Source/**/*.tga
!/Source/**/*.psd
!/Releases/**/*.fbx
!/Releases/**/*.png
!/Releases/**/*.jpg
!/Releases/**/*.jpeg

# Blender recovery and local UI state
*.blend@
*.blend~
*.blend[0-9]
*.blend1
__pycache__/
*.py[cod]
*.log

# OS/editor noise
.DS_Store
Thumbs.db
.vs/
.idea/

# Never version engine-generated caches or logs.
DerivedDataCache/
Intermediate/
Saved/
Library/
Temp/
Logs/
UserSettings/
